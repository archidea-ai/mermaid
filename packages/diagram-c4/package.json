{
  "name": "@archidea-ai/mermaid-diagram-c4",
  "version": "0.1.0",
  "description": "Native interactive React renderer for mermaid C4 diagrams",
  "keywords": [
    "mermaid",
    "c4",
    "react",
    "interactive",
    "architecture"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./c4.css": "./dist/mermaid-diagram-c4.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@archidea-ai/mermaid-core": "workspace:*",
    "@archidea-ai/mermaid-react": "workspace:*",
    "@archidea-ai/mermaid-scenario": "workspace:*",
    "@archidea-ai/mermaid-diagram-sequence": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.29.0",
    "tw-animate-css": "^1.4.0",
    "@base-ui/react": "^1.7.0"
  },
  "peerDependencies": {
    "mermaid": "^11.16.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  }
}
