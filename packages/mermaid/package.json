{
  "name": "@archidea-ai/mermaid",
  "version": "0.1.0",
  "description": "Drop-in replacement for mermaid that renders diagrams with React in the browser",
  "keywords": [
    "mermaid",
    "react",
    "diagram",
    "sequence-diagram",
    "drop-in",
    "interactive"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/react.js",
    "./dist/registry.js",
    "./src/index.ts",
    "./src/react.ts",
    "./src/registry.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@archidea-ai/mermaid-core": "workspace:*",
    "@archidea-ai/mermaid-react": "workspace:*",
    "@archidea-ai/mermaid-diagram-sequence": "workspace:*",
    "@archidea-ai/mermaid-diagram-state": "workspace:*",
    "@archidea-ai/mermaid-diagram-flowchart": "workspace:*",
    "@archidea-ai/mermaid-diagram-c4": "workspace:*",
    "@archidea-ai/mermaid-scenario": "workspace:*"
  },
  "peerDependencies": {
    "mermaid": "^11.16.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
